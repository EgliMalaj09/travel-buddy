{
  "name": "travel-app-backoffice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Travel App back office (KAN-55): a small web app for the team, using the same API as the phone app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run && vite build",
    "api:types": "openapi-typescript ../backend/openapi/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "openapi-fetch": "^0.17.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "27.4.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}