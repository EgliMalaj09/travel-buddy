# Copy to .env.local (never commit .env.local).
# Sentry DSN from your Sentry project (EU data region). Leave empty to turn Sentry off.
EXPO_PUBLIC_SENTRY_DSN=
# API address. Leave empty: web/iOS simulator use http://localhost:5001, Android emulator http://10.0.2.2:5001.
# For a real phone on Wi-Fi use your computer's IP, e.g. http://192.168.1.20:5001
EXPO_PUBLIC_API_URL=
# Login: "api" (real backend, default) or "mock" (any email, code 123456, no backend needed).
EXPO_PUBLIC_AUTH_MODE=api
# Google login (docs/google-apple-login.md). The WEB client id is needed on Android and iPhone;
# the iOS client id only on iPhone. The Windows start script also gives these to the API.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Data source for the app: "mock" (sample trips) until sync is built.
EXPO_PUBLIC_DATA_MODE=mock
