{
  "expo": {
    "name": "Travel App",
    "slug": "travel-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.travelapp.mobile",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ECE7DD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.travelapp.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#ECE7DD"
        }
      ],
      "@sentry/react-native",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE-WITH-IOS-CLIENT-ID"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Travel App to use Face ID to unlock the app."
        }
      ],
      "expo-apple-authentication",
      "expo-asset",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Travel App to add photos from your library to your trips.",
          "cameraPermission": "Allow Travel App to take photos for your trips.",
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "scheme": "travelapp",
    "experiments": {
      "typedRoutes": true
    }
  }
}
