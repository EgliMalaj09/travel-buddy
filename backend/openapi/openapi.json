  "components": {
    "schemas": {
      "AppInfoResponse": {
        "required": [
          "name",
          "version",
          "environment"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          }
        }
      },
      "AuthUserResponse": {
        "required": [
          "id",
          "email",
          "authProviders",
          "profile",
          "suggestedFirstName",
          "consents"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "authProviders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "profile": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ProfileDto"
              }
            ]
          },
          "suggestedFirstName": {
            "type": [
              "null",
              "string"
            ]
          },
          "consents": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ConsentsDto"
              }
            ]
          }
        }
      },
      "ConsentsDto": {
        "required": [
          "ageConfirmed",
          "termsAccepted",
          "marketingConsent"
        ],
        "type": "object",
        "properties": {
          "ageConfirmed": {
            "type": "boolean"
          },
          "termsAccepted": {
            "type": "boolean"
          },
          "marketingConsent": {
            "type": "boolean"
          }
        }
      },
      "FlightDto": {
        "required": [
          "id",
          "tripId",
          "order",
          "direction",
          "airline",
          "flightNumber",
          "departureAirport",
          "arrivalAirport",
