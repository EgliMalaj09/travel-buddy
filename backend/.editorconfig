root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4

# C#-only API: the folder name "Shared" (structure rules) is a VB keyword, not a C# one.
dotnet_diagnostic.CA1716.severity = none

[*.{json,csproj,props,slnx,yml,yaml}]
indent_style = space
indent_size = 2

# EF Core migrations are generated code: no style or analyzer rules.
[src/TravelApp.Api/Data/Migrations/*.cs]
generated_code = true
